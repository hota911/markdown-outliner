{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Outliner",
  "version": "../package.json",
  "identifier": "io.github.hota911.markdown-outliner",
  "build": {
    "beforeDevCommand": "npx vite --config vite.tauri.config.ts",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npx vite build --config vite.tauri.config.ts",
    "frontendDist": "../dist/tauri"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
