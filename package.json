{
  "name": "markdown-outliner",
  "version": "0.1.0",
  "description": "Outliner for Markdown task lists, as an Obsidian plugin and a local web app.",
  "license": "MIT",
  "author": "hota911",
  "repository": {
    "type": "git",
    "url": "https://github.com/hota911/markdown-outliner.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.web.config.ts",
    "build": "npm run build:web && npm run build:plugin",
    "build:plugin": "node scripts/package-plugin.mjs",
    "build:web": "vite build --config vite.web.config.ts",
    "test": "npm run test:node && npm run test:ui",
    "test:node": "node --test test/core.test.mjs test/keys.test.mjs test/server.test.mjs test/package-plugin.test.mjs",
    "test:ui": "vitest run",
    "lint": "eslint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "prestart": "npm run build:web",
    "start": "node server.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "0.14.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.4",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "obsidian": "1.8.7",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
